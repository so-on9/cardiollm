# ===== CardioLLM .env example =====
# Copy this file to `.env` and fill in your own values.

# API / UI auth
API_KEY=replace-with-your-api-key
UI_PASSWORD=replace-with-your-ui-password
SESSION_HOURS=8
COOKIE_SECURE=true
# API 文件在正式環境預設關閉，需要除錯時才暫時開啟。
DOCS_ENABLED=false
# 同一來源在 15 分鐘內失敗 6 次後，封鎖登入 15 分鐘。
LOGIN_MAX_FAILURES=6
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
KEEP_ALIVE=30m
# Comma-separated browser origins allowed for cross-origin API calls.
# Same-origin Caddy traffic does not need CORS.
CORS_ORIGINS=https://your-domain.example

# Bind / ports
PROXY_BIND=0.0.0.0
PROXY_PORT=80

# Ollama is not published to the host. Proxy reaches it via Docker DNS:
# OLLAMA_URL=http://ollama:11434

# Default models shown in the UI on first load.
# Replace these with model names that actually exist in your Ollama instance.
OLLAMA_TRANS_MODEL=llama-3.2-3b-instruct-translator-baseline150:q8
OLLAMA_SUM_MODEL=llama-3.2-3b-instruct-summarizer-complete-clinical-v5:q8

# Optional terminology RAG experiment.
# false keeps translation behavior closest to the original prompt.
# true injects matched echo terminology rules into the prompt instruction.
TERM_RAG_ENABLED=false

# Optional summary-only terminology RAG.
# This keeps translation clean while letting the summarizer use retrieved term rules.
SUMMARY_RAG_ENABLED=false
