# ===== CardioLLM K8s / remote Ollama .env example =====
# Copy this file to `.env` for local Docker Compose testing.

# API / UI auth
API_KEY=hpcverygood-api-key
UI_PASSWORD=hpcverygood
SESSION_HOURS=8
COOKIE_SECURE=true
KEEP_ALIVE=30m

# Proxy bind / ports
PROXY_BIND=0.0.0.0
PROXY_PORT=8000

# Remote Ollama on the 5070 Ti host.
OLLAMA_BASE_URL=http://140.128.103.191:11434
OLLAMA_TRANS_MODEL=llama-3.2-3b-instruct-translator-baseline150:q8
OLLAMA_SUM_MODEL=llama-3.2-3b-instruct-summarizer-clinical-v4:q5
