# ===== CardioLLM K8s / remote Ollama .env example =====
# Copy this file to `.env` for local Docker Compose testing.

# API / UI auth
API_KEY=replace-with-your-api-key
UI_PASSWORD=replace-with-your-ui-password
SESSION_HOURS=8
COOKIE_SECURE=true
KEEP_ALIVE=30m
CORS_ORIGINS=https://your-domain.example

# Proxy bind / ports
# Local compose testing should bind to 127.0.0.1 unless you have replaced dev credentials.
PROXY_BIND=127.0.0.1
PROXY_PORT=8000

# Remote Ollama on the 5070 Ti host.
# Use a protected endpoint reachable only by this proxy/K8s node, not a public Ollama API.
OLLAMA_BASE_URL=http://replace-with-protected-ollama-host:30678
OLLAMA_TRANS_MODEL=replace-with-your-translator-model:q8
OLLAMA_SUM_MODEL=replace-with-your-summarizer-model:q8
