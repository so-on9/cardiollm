# ===== CardioLLM K8s / remote Ollama .env example =====
# Copy this file to `.env` for local Docker Compose testing.

# API / UI auth
API_KEY=replace-with-your-api-key
UI_PASSWORD=replace-with-your-ui-password
SESSION_HOURS=8
COOKIE_SECURE=true
KEEP_ALIVE=30m

# Proxy bind / ports
PROXY_BIND=replace-with-proxy-bind-address
PROXY_PORT=8000

# Remote Ollama on the 5070 Ti host.
OLLAMA_BASE_URL=http://replace-with-ollama-host:11434
OLLAMA_TRANS_MODEL=replace-with-your-translator-model
OLLAMA_SUM_MODEL=replace-with-your-summarizer-model
