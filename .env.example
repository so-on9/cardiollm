# ===== CardioLLM .env example =====
# Copy this file to `.env` and fill in your own values.

# API / UI auth
API_KEY=replace-with-your-api-key
UI_PASSWORD=replace-with-your-ui-password
SESSION_HOURS=8
COOKIE_SECURE=true
KEEP_ALIVE=30m
# Comma-separated browser origins allowed for cross-origin API calls.
# Same-origin Caddy traffic does not need CORS.
CORS_ORIGINS=https://your-domain.example

# Bind / ports
PROXY_BIND=0.0.0.0
PROXY_PORT=80

# Ollama is not published to the host. Proxy reaches it via Docker DNS:
# OLLAMA_URL=http://ollama:11434

# Default models shown in the UI on first load.
# Replace these with model names that actually exist in your Ollama instance.
OLLAMA_TRANS_MODEL=llama-3.2-3b-instruct-translator-baseline150:q8
OLLAMA_SUM_MODEL=llama-3.2-3b-instruct-summarizer-complete-clinical-v5:q8
