# ===== CardioLLM K8s remote Ollama example =====
# This version runs only the web/proxy service.
# Ollama + GGUF models remain on the 5070 Ti host.

API_KEY=replace-with-your-api-key
UI_PASSWORD=replace-with-your-ui-password
SESSION_HOURS=8
COOKIE_SECURE=true
DOCS_ENABLED=false
LOGIN_MAX_FAILURES=6
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
KEEP_ALIVE=30m
CORS_ORIGINS=https://your-domain.example

# Local docker-compose testing only. K8s uses Service/Ingress instead.
PROXY_BIND=127.0.0.1
PROXY_PORT=8000

# Use a protected endpoint reachable only by this proxy/K8s node, not a public Ollama API.
OLLAMA_URL=http://replace-with-protected-ollama-host:30678
OLLAMA_TRANS_MODEL=replace-with-your-translator-model:q8
OLLAMA_SUM_MODEL=replace-with-your-summarizer-model:q8

TERM_RAG_ENABLED=false
SUMMARY_RAG_ENABLED=true
IMAGE_BACKEND=local_warp
IMAGE_MODEL=Local anatomical warp
COMFYUI_IMAGE_SIZE=512
COMFYUI_DENOISE=0.42
